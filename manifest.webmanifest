{
  "id": "./",
  "name": "Material Wizard",
  "short_name": "Material Wizard",
  "description": "Make PBR materials for BeamNG.drive from one photo: base color, height, normal, roughness, metallic, AO and opacity, with seamless tiling. Runs in your browser, nothing is uploaded.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "categories": ["graphics", "design", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-material-wizard": [".mwz"] } }
  ]
}
